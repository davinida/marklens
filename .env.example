# MarkLens 환경변수 예시 — 이 파일을 복사해 .env 로 저장하고 값을 채우세요.
# .env 는 .gitignore 로 커밋이 차단됩니다 (KIPRIS 키 공유는 약관 위반 — 각자 발급).

# ── 저장소 모드 (백엔드-1~4) ─────────────────────────────────────────
# 설정하면 상표 메타를 PostgreSQL 에서 조회(db 모드), 비우면 기존 JSON 파일 모드.
# 마이그레이션: python -m backend.scripts.migrate_json_to_db
# 형식(R5 검증): 설정 시 postgresql:// (또는 postgres://) 스킴이어야 기동됩니다.
#DATABASE_URL=postgresql://postgres:비밀번호@127.0.0.1:5432/marklens

# ── 데이터/이미지 경로 오버라이드 (백엔드-3 1단계, 선택) ─────────────
# 미설정 시 기본값: <repo>/ml/data, <repo>/ml/data/images
#MARKLENS_DATA_DIR=E:\marklens-data
#MARKLENS_IMAGES_DIR=E:\marklens-data\images

# ── KIPRIS Plus Open API (백엔드-6 본 수집 / 백엔드-7 호칭 검색) ────────
# 키: plus.kipris.or.kr 마이페이지 → 상품별 인증키 (처리상태 "사용중" 확인)
# 하나의 KIPRIS_ACCESS_KEY 값을 두 오퍼레이션 계열이 공용한다. 단, 계열마다
# 인증 파라미터 "이름"이 다르다(코드가 자동으로 골라 붙인다):
#   - 상표명완전일치(trademarkNameMatchSearchInfo, /name-check): 인증 accessKey, 응답 PascalCase
#   - 항목별검색(getAdvancedSearch, 본 수집):                    인증 ServiceKey, 응답 camelCase
# 잘못된 이름으로 붙이면 resultCode=10(INVALID_REQUEST_PARAMETER_ERROR) 이 온다.
#KIPRIS_ACCESS_KEY=발급받은키

# 공통 호스트. 아래 오퍼레이션 URL 을 비워두면 이 값 + 경로 상수로 전체 URL 을 자동 조합한다.
#KIPRIS_BASE_URL=http://plus.kipris.or.kr/

# 오퍼레이션 URL 오버라이드(둘 다 선택 — 미설정 시 KIPRIS_BASE_URL 로 자동 조합).
# 통합설명서상 경로가 바뀌었을 때만 여기서 덮어쓴다.
#KIPRIS_TM_NAME_SEARCH_URL=http://plus.kipris.or.kr/openapi/rest/trademarkInfoSearchService/trademarkNameMatchSearchInfo
#KIPRIS_TM_NAME_PARAM=trademarkNameMatch
#KIPRIS_APPLICANT_SEARCH_URL=http://plus.kipris.or.kr/kipo-api/kipi/trademarkInfoSearchService/getAdvancedSearch
#KIPRIS_APPLICANT_PARAM=applicantName

# 월 호출 예산(공식 한도 1,000회, 여유분 남김)과 최소 호출 간격(초)
#KIPRIS_MONTHLY_BUDGET=950
#KIPRIS_MIN_INTERVAL=0.1

# /name-check 동일 질의 캐시 TTL (초, 기본 86400 = 24시간)
#KIPRIS_NAME_CACHE_TTL=86400

# ── 시연 하드닝: CORS 허용 오리진 (R12) ─────────────────────────────
# 콤마 구분 오리진 목록. 미설정 기본값: http://localhost:3000,http://127.0.0.1:3000
# 배포/시연 시 실제 프론트엔드 오리진으로 한정 (과거 "*" 하드코딩 제거).
# 형식(R5 검증): 콤마로 구분된 오리진이 최소 1개는 있어야 기동됩니다(빈 값 불가).
#MARKLENS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── 시연 하드닝: 정적 X-API-Key 인증 (R12) ──────────────────────────
# 설정하면 /search·/name-check 요청에 X-API-Key 헤더 일치를 요구(불일치 401).
# 미설정이면 완전 비활성(무인증) — 로컬 개발 기본. /health·/docs·/images 는 항상 제외.
# 값은 추측 불가능한 긴 무작위 문자열을 권장 (예: openssl rand -hex 24).
#MARKLENS_API_KEY=시연용-무작위-긴-문자열

# ── 시연 하드닝: 인바운드 레이트리밋 (R12) ──────────────────────────
# IP 기준 요청 한도. slowapi 포맷("<횟수>/<주기>"). 미설정 시 아래 기본값 적용.
# /search 는 CPU(CLIP+FAISS) 보호, /name-check 는 KIPRIS 월 쿼터 보호가 목적.
# 형식(R5 검증): "<정수>/<단위>" 여야 기동됩니다
#   (단위: second/minute/hour/day/month/year, 예: 10/minute, 30 per hour).
#MARKLENS_SEARCH_RATELIMIT=10/minute
#MARKLENS_NAMECHECK_RATELIMIT=30/minute
