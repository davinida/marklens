# MarkLens 환경변수 예시 — 이 파일을 복사해 .env 로 저장하고 값을 채우세요.
# .env 는 .gitignore 로 커밋이 차단됩니다 (KIPRIS 키 공유는 약관 위반 — 각자 발급).

# ── 저장소 모드 (백엔드-1~4) ─────────────────────────────────────────
# 설정하면 상표 메타를 PostgreSQL 에서 조회(db 모드), 비우면 기존 JSON 파일 모드.
# 마이그레이션: python -m backend.scripts.migrate_json_to_db
#DATABASE_URL=postgresql://postgres:비밀번호@127.0.0.1:5432/marklens

# ── 데이터/이미지 경로 오버라이드 (백엔드-3 1단계, 선택) ─────────────
# 미설정 시 기본값: <repo>/ml/data, <repo>/ml/data/images
#MARKLENS_DATA_DIR=E:\marklens-data
#MARKLENS_IMAGES_DIR=E:\marklens-data\images

# ── KIPRIS Plus Open API (백엔드-5 수집 / 백엔드-7 호칭 검색) ────────
# 키: plus.kipris.or.kr 마이페이지 → 상품별 인증키 (처리상태 "사용중" 확인)
# 오퍼레이션 URL/파라미터명: 사이트 상단 "API 통합설명서"에서 확인
#KIPRIS_ACCESS_KEY=발급받은키
#KIPRIS_TM_NAME_SEARCH_URL=http://plus.kipris.or.kr/openapi/rest/trademarkInfoSearchService/trademarkNameMatchSearchInfo
#KIPRIS_TM_NAME_PARAM=trademarkNameMatch
#KIPRIS_APPLICANT_SEARCH_URL=http://plus.kipris.or.kr/openapi/rest/...
#KIPRIS_APPLICANT_PARAM=applicantName

# 월 호출 예산(공식 한도 1,000회, 여유분 남김)과 최소 호출 간격(초)
#KIPRIS_MONTHLY_BUDGET=950
#KIPRIS_MIN_INTERVAL=0.1

# /name-check 동일 질의 캐시 TTL (초, 기본 86400 = 24시간)
#KIPRIS_NAME_CACHE_TTL=86400
