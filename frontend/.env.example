# Private server-only values. Never expose these with a NEXT_PUBLIC_ prefix.
MARKLENS_BACKEND_URL=http://127.0.0.1:8000
MARKLENS_BACKEND_API_KEY=
MARKLENS_TURNSTILE_SECRET_KEY=
# Comma-separated hostnames. Set this explicitly in production.
MARKLENS_TURNSTILE_EXPECTED_HOSTNAMES=localhost

# The Turnstile site key is public by design. It is now served to the widget at
# request time via /api/turnstile-config, so changing it does NOT require a
# rebuild. Server-only MARKLENS_TURNSTILE_SITE_KEY takes precedence when set;
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is kept as a fallback for existing setups.
#MARKLENS_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Local development only. Both flags must be set to 1; production ignores them.
# MARKLENS_TURNSTILE_DEV_BYPASS=1
# NEXT_PUBLIC_TURNSTILE_DEV_BYPASS=1
