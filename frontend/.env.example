# Private server-only values. Never expose these with a NEXT_PUBLIC_ prefix.
MARKLENS_BACKEND_URL=http://127.0.0.1:8000
MARKLENS_BACKEND_API_KEY=
MARKLENS_TURNSTILE_SECRET_KEY=
# Comma-separated hostnames. Set this explicitly in production.
MARKLENS_TURNSTILE_EXPECTED_HOSTNAMES=localhost

# The Turnstile site key is public by design. It is served to the widget at
# request time via /api/turnstile-config. Server-only MARKLENS_TURNSTILE_SITE_KEY
# is the recommended runtime source: changing it needs only an env edit plus a
# restart, no rebuild. A blank value is treated as unset, so the fallback below
# still applies.
#MARKLENS_TURNSTILE_SITE_KEY=

# Fallback kept for existing local setups. Caveat: NEXT_PUBLIC_* is inlined at
# build time, so in the Docker standalone build this fallback CANNOT rotate the
# key without a rebuild. Use MARKLENS_TURNSTILE_SITE_KEY for that.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Local development only; production ignores it. This is the single bypass flag
# read by both the widget config route and server-side verification.
# MARKLENS_TURNSTILE_DEV_BYPASS=1
