# Copy to .env.production and replace every blank value before compose startup.
# Never commit .env.production.
MARKLENS_PORT=8080
# Keep loopback unless a firewall-restricted trusted edge connects directly.
MARKLENS_BIND_ADDRESS=127.0.0.1
PUBLIC_ORIGIN=

# Use a URL-safe value because Compose also places it in DATABASE_URL.
# Example generator: openssl rand -hex 32
POSTGRES_PASSWORD=
MARKLENS_API_KEY=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
MARKLENS_TURNSTILE_SECRET_KEY=
MARKLENS_TURNSTILE_EXPECTED_HOSTNAMES=

# Rotate the previously used key after the HTTPS and log-redaction release.
KIPRIS_ACCESS_KEY=

# Keep false until KIPRIS confirms public image redistribution rights in writing.
MARKLENS_PUBLIC_RESULT_IMAGES=false
